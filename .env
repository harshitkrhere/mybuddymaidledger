# ============================================================
# Database — Neon PostgreSQL (production) / embedded Postgres (dev)
# ============================================================
# PRODUCTION (Neon): replace the two values below with your project's
# strings from https://console.neon.tech  (Project → Dashboard):
#
#   DATABASE_URL        → POOLED connection (host contains "-pooler") — used
#                         by the app at runtime so serverless traffic can't
#                         exhaust connections:
#   DATABASE_URL=postgresql://[user]:[password]@[host]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
#
#   DIRECT_DATABASE_URL → DIRECT connection (no "-pooler") — used ONLY for
#                         migrations (`npm run db:migrate:deploy`):
#   DIRECT_DATABASE_URL=postgresql://[user]:[password]@[host].[region].aws.neon.tech/[dbname]?sslmode=require
#
# SSL is strictly enforced: keep ?sslmode=require on both URLs.
# Never commit real credentials — set them as platform env vars in production.
#
# ------------------------------------------------------------
# LOCAL DEV: the values below point at the embedded PostgreSQL 18 that
# `npm run db:local:start` boots on 127.0.0.1:5433 (same engine as Neon,
# same SQL migrations). The dev server wires this automatically.
# ------------------------------------------------------------
DATABASE_URL=postgresql://ledger:ledger@127.0.0.1:5433/ledger?schema=public&connection_limit=10&pool_timeout=20&connect_timeout=15
DIRECT_DATABASE_URL=postgresql://ledger:ledger@127.0.0.1:5433/ledger?schema=public

# Fallback only (packaged sandbox preview without Postgres available):
# DATABASE_URL=file:/home/z/my-project/db/custom.db
