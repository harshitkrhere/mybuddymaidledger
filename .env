# --- Local development (SQLite) ---
DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- To deploy on PostgreSQL (Neon/Supabase/Railway, free tier) ---
# 1. Run: npm run db:use-postgres   (flips prisma/schema.prisma provider)
# 2. Set DATABASE_URL to your POOLED connection string as a platform env var
#    (Neon: host contains "-pooler", include ?sslmode=require — never commit it)
# 3. Run: npx prisma generate && npx prisma db push && npm run db:seed
# To switch back to local dev: npm run db:use-sqlite
