generator client {
  provider = "prisma-client-js"
}

// ============================================================
// Production database: Neon PostgreSQL (serverless).
//   · DATABASE_URL        — POOLED connection string ("-pooler" host,
//                           ?sslmode=require) used by the app at runtime.
//   · DIRECT_DATABASE_URL — direct (non-pooled) connection, used ONLY
//                           by `prisma migrate` / `prisma db push`.
// Local development without a Neon project: `npm run db:local:start`
// boots an embedded PostgreSQL 18 on 127.0.0.1:5433 with the same
// schema and migrations, so dev and production run the same engine.
// ============================================================

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_DATABASE_URL")
}

// =============================
// Users & Access Control
// Hierarchy: RED > ADMIN > MANAGER > EMPLOYEE
// =============================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("EMPLOYEE") // RED | ADMIN | MANAGER | EMPLOYEE
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE
  title        String? // job title, e.g. "Finance Manager"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  submittedExpenses   Expense[]              @relation("ExpenseSubmitter")
  reviewedExpenses    Expense[]              @relation("ExpenseReviewer")
  createdTransactions Transaction[]          @relation("TransactionCreator")
  createdInvoices     Invoice[]              @relation("InvoiceCreator")
  auditEntries        AuditLog[]             @relation("AuditActor")

  @@index([role])
  @@index([status])
}

model Session {
  id        String   @id // opaque random token stored in httpOnly cookie
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// =============================
// Finance core
// =============================

model Category {
  id       String  @id @default(cuid())
  name     String  @unique
  type     String // INCOME | EXPENSE
  isActive Boolean @default(true)

  transactions Transaction[]
  expenses     Expense[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("CLIENT") // CLIENT | VENDOR
  email     String?
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices     Invoice[]
  transactions Transaction[]

  @@index([type])
  @@index([name])
}

model Transaction {
  id            String   @id @default(cuid())
  date          DateTime
  type          String // INCOME | EXPENSE
  amount        Float
  description   String
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id])
  reference     String? // invoice / UTR / receipt number
  paymentMethod String   @default("BANK") // UPI | BANK | CARD | CASH
  createdById   String?
  createdBy     User?     @relation("TransactionCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([date])
  @@index([type])
  @@index([categoryId])
}

model Invoice {
  id          String    @id @default(cuid())
  number      String    @unique
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  issueDate   DateTime
  dueDate     DateTime?
  status      String    @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE
  subtotal    Float     @default(0)
  taxRate     Float     @default(18)
  taxAmount   Float     @default(0)
  total       Float     @default(0)
  notes       String?
  createdById String?
  createdBy   User?     @relation("InvoiceCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items InvoiceItem[]

  @@index([status])
  @@index([clientId])
  @@index([issueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  amount      Float   @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Expense {
  id           String    @id @default(cuid())
  submittedById String
  submitter    User      @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  date         DateTime
  amount       Float
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  description  String
  receiptRef   String? // receipt number / attachment reference
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewer     User?     @relation("ExpenseReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([submittedById])
  @@index([date])
}

// =============================
// Governance
// =============================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String // LOGIN | LOGOUT | USER_CREATED | ROLE_CHANGED | ...
  targetType String? // USER | TRANSACTION | INVOICE | EXPENSE | CLIENT | SETTINGS
  targetId   String?
  targetLabel String? // human-readable target, e.g. user email
  detail     String? // JSON payload with before -> after values
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

model CompanySettings {
  id          String   @id @default("singleton")
  companyName String   @default("My Company")
  currency    String   @default("INR")
  taxRate     Float    @default(18)
  email       String?
  phone       String?
  address     String?
  updatedAt   DateTime @updatedAt
}
