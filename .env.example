# ============================================================
# Environment Variables — Ledger Portal (Neon PostgreSQL)
# Copy this to .env locally or set these in the Vercel Dashboard
# ============================================================

# 1. DATABASE_URL: Neon Pooled Connection String (PgBouncer, host with -pooler)
# Used by runtime Next.js API routes to prevent connection exhaustion.
DATABASE_URL="postgresql://[user]:[password]@[host]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# 2. DIRECT_DATABASE_URL: Neon Direct Connection String (no -pooler)
# Used ONLY by Prisma Migrate for schema migrations and DDL.
DIRECT_DATABASE_URL="postgresql://[user]:[password]@[host].[region].aws.neon.tech/[dbname]?sslmode=require"

# 3. Initial Seed Account Passwords (minimum 8 characters)
SEED_PASSWORD_RED="SetYourSecureRedPasswordHere123!"
SEED_PASSWORD_ADMIN="SetYourSecureAdminPasswordHere123!"
SEED_PASSWORD_MANAGER="SetYourSecureManagerPasswordHere123!"
SEED_PASSWORD_EMPLOYEE="SetYourSecureEmployeePasswordHere123!"
